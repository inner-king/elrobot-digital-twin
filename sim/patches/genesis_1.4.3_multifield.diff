+                    n = n / n_norm
+                    v0 = self.grid[f, I, i_b].vel_out
+                    v1 = self.grid1[f, I, i_b].vel_out
+                    if (v0 - v1).dot(n) > 0:  # 서로 다가가는 중일 때만 접촉
+                        vcm = (m0 * v0 + m1 * v1) / (m0 + m1)
+                        d0 = (v0 - vcm).dot(n)
+                        d1 = (v1 - vcm).dot(n)
+                        v0 = v0 - d0 * n
+                        v1 = v1 - d1 * n
+                        mu = self.mf_mu[None]
+                        if mu > 0:
+                            t0 = v0 - vcm
